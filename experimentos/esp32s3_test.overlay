#include <zephyr/dt-bindings/gpio/gpio.h>
#include <espressif/esp32s3/esp32s3_wroom_n16.dtsi>

&uart0 {
    status = "disabled";
};

&usb_serial {
    status = "okay";
};

/ {
    chosen {
        zephyr,console = &usb_serial;
        zephyr,shell-uart = &usb_serial;
    };

    zephyr,user {
        button-gpios = <&gpio0 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        stim-gpios = <&gpio0 18 GPIO_ACTIVE_LOW>;
    };
};
